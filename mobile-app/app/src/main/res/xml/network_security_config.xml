<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly disallow all cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only trusted system CA certificates; ignore user-installed proxy certs (Burp/Charles) in release -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Enforce HTTPS and strict certificates for backend domain -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">theeternalecho.asloobulhayat.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
